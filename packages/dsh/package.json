{
  "name": "dsh-session-recap",
  "version": "0.6.1",
  "description": "Recap any dsh session (and Claude Code, Codex and OpenCode sessions): intent, key decisions, what changed, open threads and where to resume. Adds the session_recap tool and the /recap command.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "client",
    "vendor",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "session",
    "recap",
    "summary"
  ],
  "author": "BruceXcluding",
  "license": "MIT",
  "homepage": "https://github.com/BruceXcluding/session-recap/tree/main/packages/dsh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BruceXcluding/session-recap.git",
    "directory": "packages/dsh"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.0-rc.1 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
